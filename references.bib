  author = {Sanford, Adam G. and Smith, Stacy L. and Blum, Dinur},
  year = 2025,
  pages = {1--3},
  publisher = {John Wiley \& Sons, Ltd},
  doi = {10.1002/9781405165518.wbeos2021},
  urldate = {2026-06-23},
  abstract = {Memetics, or the study of memes, is an emerging discipline in cultural evolution. At its core, memetics is based on the idea that culture can be reduced to the study of cultural units, called memes: ideas, behaviors, beliefs, and expressions that spread from person to person in a culture through imitation. In this view, the meme is the cultural version of a gene, a unit of cultural transmission. As memetics is a new discipline, the definitions and boundaries of its scope are still up for debate and discussion, including what the meme is, how it should be studied, and whether memetics qualifies as a science. Most current memetics research focuses on using memetics as a methodology to examine culture and the movement of ideas through culture.},
  copyright = {Copyright \copyright{} 2025 John Wiley \& Sons, Ltd All rights reserved.},
  isbn = {978-1-4051-6551-8},
  langid = {english},
  keywords = {conceptual framework,gene-culture coevolution (GCCE),Internet meme,memes,memetics,viral idea},
  file = {/Users/matthieu/Zotero/storage/P6VJFFQ5/9781405165518.html}
}

@article{savageCulturalEvolutionMusic2019,
