@incollection{guimondChapitreCommentSe2010,
  title = {{Chapitre 3. Comment se transmet la culture~? Les processus de socialisation}},
  booktitle = {{Psychologie sociale : perspective multiculturelle}},
  author = {Guimond, Serge},
  year = 2010,
  series = {{PSY-Individus, groupes, culture}},
  pages = {51--74},
  publisher = {Mardaga},
  address = {Wavre},
  abstract = {Au carrefour d'une pr\'eoccupation pour les ph\'enom\`enes psychologiques et pour les faits de soci\'et\'e, la psychologie sociale occupe une place privil\'egi\'ee parmi les sciences humaines et sociales. Dans un langage simple et accessible, cet ouvrage en expose les principes fondamentaux et offre, pour la premi\`ere fois en langue fran\c caise, une perspective multiculturelle sur les objets d'\'etudes de la psychologie sociale. Une telle perspective qui place l'influence de la culture au centre de l'analyse est devenue incontournable. Les recherches r\'ealis\'ees au cours des 30 derni\`eres ann\'ees ont en effet convaincu les psychologues sociaux, en Am\'erique comme en Europe, qu'il n'est plus possible de pr\'etendre d\'evelopper des th\'eories g\'en\'erales du comportement humain tout en \'etudiant les ph\'enom\`enes psychologiques au sein d'une seule culture. Consid\'erer le r\^ole de la culture, c'est questionner le fondement m\^eme de la discipline : Les lois de la psychologie sociale sont-elles universelles ? Les ph\'enom\`enes de conformisme ou d'influence \'etudi\'es classiquement en psychologie sociale prennent-ils des formes diff\'erentes selon le contexte culturel? La culture exerce-t-elle une influence d\'eterminante sur le fonctionnement psychologique ? Les st\'er\'eotypes culturels ont-ils un fondement dans la r\'ealit\'e ? Quels sont les moyens d'am\'eliorer les relations entre les membres de communaut\'es culturelles distinctes ? En dix chapitres, ce volume fait le point sur ces questions en introduisant les principales th\'eories et recherches de la psychologie sociale, en \'evaluant leur validit\'e interculturelle, et en \'elaborant les questions \`a approfondir. Il offre ainsi une perspective d'int\'egration qui s'av\`ere essentielle face \`a l'accroissement des connaissances dans les sciences humaines et sociales.},
  isbn = {978-2-8047-0032-4},
  langid = {french},
  keywords = {notion}
}

