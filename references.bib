@article{henrichbernardoniVoixInstrumentTimbre2021,
  title = {{La voix, un instrument de timbre. Comment joue-t-on du timbre vocal ?}},
  author = {Henrich Bernardoni, Nathalie and Castellengo, Mich{\`e}le},
  year = 2021,
  month = dec,
  journal = {Cahiers d'ethnomusicologie. Anciennement Cahiers de musiques traditionnelles},
  number = {34},
  pages = {17--36},
  publisher = {Infolio Editeur / Ateliers d'ethnomusicologie},
  issn = {1662-372X},
  urldate = {2025-07-19},
  abstract = {Tout \`a la fois luthier, instrument et instrumentiste, le chanteur ajuste et contr\^ole finement les diverses parties de son instrument pour <<~jouer du timbre vocal~>>. Le lien entre gestes et timbres est analys\'e en s'appuyant sur diverses r\'ealisations remarquables mises en \oe uvre dans quelques chants traditionnels du monde~: le chant f\'eminin bulgare, la technique du yodel, le tahrir iranien, le chant diphonique et quelques polyphonies de Sardaigne, de Centrafrique et de Ta\"iwan. La diversit\'e et la pr\'ecision de ces r\'ealisations est l'expression sonore d'un jeu d'\'equilibre entre le souffle, la vibration de plis laryng\'es et les r\'esonances vocaliques du conduit vocal. Les pratiques vocales mises en lumi\`ere dans cet article et diss\'equ\'ees sous le regard de l'analyse acoustique et physiologique t\'emoignent de l'extraordinaire plasticit\'e de l'instrument vocal humain et de la richesse inou\"ie des jeux de timbres des chanteurs.},
  copyright = {https://creativecommons.org/licenses/by-sa/4.0/},
  isbn = {9782889680320},
  langid = {french},
  file = {/Users/matthieu/Zotero/storage/LFTCWTIE/Henrich Bernardoni et Castellengo - 2021 - La voix, un instrument de timbre. Comment joue-t-on du timbre vocal .pdf}
}

