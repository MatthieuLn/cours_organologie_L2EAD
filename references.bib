@article{hargitaiHallyuHeartEurope2023,
  title = {Hallyu in the {{Heart}} of {{Europe}}: {{The}} Rise of the {{Korean Wave}} in the Digital Space},
  shorttitle = {Hallyu in the {{Heart}} of {{Europe}}},
  author = {Hargitai, D{\'a}vid M{\'a}t{\'e} and Gr{\'o}sz, Annam{\'a}ria Sasn{\'e} and Sas, Zs{\'o}fia},
  year = 2023,
