  doi = {10.7202/1055893ar},
  urldate = {2025-05-13},
  abstract = {La famille est au coeur du tissu social des communaut\'es autochtones. Or, contrairement aux soci\'et\'es occidentales, les Autochtones ont une conception \'elargie de la famille. En se fondant sur des r\'ecits biographiques de membres de la communaut\'e innue d'Uashat mak Mani-Utenam, le pr\'esent texte explore plusieurs facettes du concept de famille \'elargie. Pour les Innus, la famille \'elargie donne lieu \`a un ensemble de devoirs et d'obligations. La cohabitation et la garde coutumi\`ere constituent des exemples de formes sp\'ecifiques de relations qui d\'ecoulent du concept de famille \'elargie. On peut concevoir celle-ci comme un ensemble de cercles concentriques, avec l'enfant au centre, qui d\'efinissent des r\^oles sp\'ecifiques. Les allochtones qui interviennent aupr\`es des Innus doivent n\'ecessairement tenir compte de ces sp\'ecificit\'es de la famille \'elargie.},
  langid = {french},
  keywords = {familles,family,Indigenous people,intervention sociale,Peuples autochtones,social intervention},
  file = {/Users/matthieu/Zotero/storage/XW3GIAVG/Guay et al. - 2018 - La famille élargie, incontournable chez les Innus.pdf;/Users/matthieu/Zotero/storage/XTHT2QLY/1055893ar.html}
