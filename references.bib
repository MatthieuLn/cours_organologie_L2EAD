@article{tacailleChansonPolyphoniqueRenaissance2000,
  title = {La Chanson Polyphonique de La {{Renaissance}}},
  author = {Tacaille, Alice and Dumont, Sandrine and Janela, David},
  year = 2000,
  journal = {Musurgia},
  volume = {7},
  number = {3/4},
  eprint = {40567128},
  eprinttype = {jstor},
  pages = {19--47},
  publisher = {Editions ESKA},
  issn = {1257-7537},
  urldate = {2025-05-06},
  abstract = {Les trois chansons \'etudi\'ees ici, La Guerre de Janequin, Mille regretz de Josquin et Il est bel et bon de Passereau, ont \'et\'e publi\'ees entre 1529 et 1534. Elles sont pourtant aussi diff\'erentes que possible, par le choix des sujets, la qualit\'e litt\'eraire des textes, la facture musicale et la destination. La structure musicale de La Guerre est litt\'eralement travers\'ee par le texte, qui justifie aussi les effets descriptifs. Mille regretz illustre une atmosph\`ere de melancolie, chaque vers etant traite dans une couleur propre. Il est bel et bon utilise diff\'erents types d'\'ecriture musicale pour exprimer les intentions du texte. Les trois mises en musique obeissent a des presupposes diff\'erents, au sein d'un m\^eme type polyphonique : Josquin a une lecture abstraite du texte, Janequin s'attache a la peinture sonore, tandis que Passereau privilegie une reponse physique au texte. The three chansons studied here, Janequin's La Guerre, Josquin's Mille regretz and Passereau's Il est bel et bon, have been published between 1529 and 1534. Yet they differ as much as is possible by the choice of the subjects, the literary quality of the texts, the musical fabric and the destination. The musical structure of La Guerre is litterally transfixed by the text, that also justifies the descriptive effects. Mille regretz illustrates a melancholic atmosphere, each verse being treated in its own colour. Il est bel et bon makes use of different types of musical writing in order to illustrate the intentions of the text. The three settings obey different presuppositions within a similar type of polyphony: Josquin gives an abstract reading of the text, Janequin tries musical painting, while Passereau proposes a physical answer to the text.},
  file = {/Users/matthieu/Zotero/storage/GP67N655/Tacaille et al. - 2000 - La chanson polyphonique de la Renaissance.pdf}
}

