@article{kohdaFurtherEvidenceCapacity2022,
  title = {Further Evidence for the Capacity of Mirror Self-Recognition in Cleaner Fish and the Significance of Ecologically Relevant Marks},
  author = {Kohda, Masanori and Sogawa, Shumpei and Jordan, Alex L. and Kubo, Naoki and Awata, Satoshi and Satoh, Shun and Kobayashi, Taiga and Fujita, Akane and Bshary, Redouan},
  year = 2022,
  month = feb,
  journal = {PLOS Biology},
  volume = {20},
  number = {2},
  pages = {e3001529},
  publisher = {Public Library of Science},
  issn = {1545-7885},
  doi = {10.1371/journal.pbio.3001529},
  urldate = {2026-03-10},
  abstract = {An animal that tries to remove a mark from its body that is only visible when looking into a mirror displays the capacity for mirror self-recognition (MSR), which has been interpreted as evidence for self-awareness. Conservative interpretations of existing data conclude that convincing evidence for MSR is currently restricted to great apes. Here, we address proposed shortcomings of a previous study on MSR in the cleaner wrasse Labroides dimidiatus, by varying preexposure to mirrors and by marking individuals with different colors. We found that (1) 14/14 new individuals scraped their throat when a brown mark had been provisioned, but only in the presence of a mirror; (2) blue and green color marks did not elicit scraping; (3) intentionally injecting the mark deeper beneath the skin reliably elicited spontaneous scraping in the absence of a mirror; (4) mirror-naive individuals injected with a brown mark scraped their throat with lower probability and/or lower frequency compared to mirror-experienced individuals; (5) in contrast to the mirror images, seeing another fish with the same marking did not induce throat scraping; and (6) moving the mirror to another location did not elicit renewed aggression in mirror-experienced individuals. Taken together, these results increase our confidence that cleaner fish indeed pass the mark test, although only if it is presented in ecologically relevant contexts. Therefore, we reiterate the conclusion of the previous study that either self-awareness in animals or the validity of the mirror test needs to be revised.},
  langid = {english},
  keywords = {A lire,Aggression,Chimpanzees,Learning,Macaque,Mirrors,Reflection,Swimming,Throat},
  file = {/Users/matthieu/Zotero/storage/5PY7HNZ2/Kohda et al. - 2022 - Further evidence for the capacity of mirror self-recognition in cleaner fish and the significance of.pdf}
}

@article{kolipakamBayesianPhylogeneticStudy2018,
  title = {A {{Bayesian}} Phylogenetic Study of the {{Dravidian}} Language Family},
  author = {Kolipakam, Vishnupriya and Jordan, Fiona M. and Dunn, Michael and Greenhill, Simon J. and Bouckaert, Remco and Gray, Russell D. and Verkerk, Annemarie},
  year = 2018,
  month = mar,
  journal = {Royal Society Open Science},
  volume = {5},
  number = {3},
  pages = {171504},
  issn = {2054-5703},
  doi = {10.1098/rsos.171504},
  urldate = {2025-10-18},
  abstract = {The Dravidian language family consists of about 80 varieties (Hammarstr\"om H. 2016 Glottolog 2.7) spoken by 220 million people across southern and central India and surrounding countries (Steever SB. 1998 In The Dravidian languages (ed. SB Steever), pp. 1--39: 1). Neither the geographical origin of the Dravidian language homeland nor its exact dispersal through time are known. The history of these languages is crucial for understanding prehistory in Eurasia, because despite their current restricted range, these languages played a significant role in influencing other language groups including Indo-Aryan (Indo-European) and Munda (Austroasiatic) speakers. Here, we report the results of a Bayesian phylogenetic analysis of cognate-coded lexical data, elicited first hand from native speakers, to investigate the subgrouping of the Dravidian language family, and provide dates for the major points of diversification. Our results indicate that the Dravidian language family is approximately 4500 years old, a finding that corresponds well with earlier linguistic and archaeological studies. The main branches of the Dravidian language family (North, Central, South I, South II) are recovered, although the placement of languages within these main branches diverges from previous classifications. We find considerable uncertainty with regard to the relationships between the main branches.},
  pmcid = {PMC5882685},
  pmid = {29657761},
  keywords = {En cours de lecture},
  file = {/Users/matthieu/Zotero/storage/GVF3KPKM/Kolipakam et al. - 2018 - A Bayesian phylogenetic study of the Dravidian language family.pdf}
}

@book{kooSoundBorderMusic2022,
  title = {Sound of the Border: Music and Identity of {{Korean}} Minority Nationality in {{China}}},
  shorttitle = {Sound of the Border},
  author = {Koo, Sunhee},
  year = 2022,
  series = {Music and Performing Arts of {{Asia}} and the {{Pacific}}},
  publisher = {University of Hawai'i Press},
  address = {Honolulu},
  abstract = {China's Northeastern Border and Korean Migration to China -- Korean Music in China : In the Past and in the Present Day -- The Construction of Chaoxianzu Musical Identity -- The Chaoxianzu Kayag\u um : Tradition Fused with Modernity -- Musical Signs and Essentializing Chaoxianzuness -- Chaoxianzu Vocal Music : Its Development and Dissemination -- Returning to a Home Never Lived In? Chaoxianzu Musicians in South Korea ; "Using ethnographic data collected in China and South Korea between 2004 and 2011, Sound of the Border provides a comprehensive view of the music of Koreans in China (Chaoxianzu), from its time as manifestation of a displaced culture to its return home after more than a century of amalgamation and change in China. As the first English-language book on the music and identity of China's Korean minority community, this study investigates diasporic mutations of Korean culture, influenced by power dynamics in the host country and the constant renewal of relationships with the homeland. Between the 1860s and the 1940s, about two million Koreans migrated to China in search of economic opportunity and political stability. Settling primarily in the northeastern part of China bordering the Russian Far East, these Koreans had flexibility in crossing geopolitical and cultural boundaries throughout the first half of the twentieth century. In 1949, the majority of Koreans in China accepted their new citizenship designation as one of the PRC's fifty-five official national minorities. The subsequent partition of the Korean peninsula in 1953 further politicized their ethnic identity, and for the next forty years they were only authorized to interact with North Korea. It was only in the early 1990s that Chaoxianzu were able to renew their relationship with South Korea, although they now faced new challenges due to an ethno-national prejudice as it focused on the nation's industrial advancement as the most prominent measure of its social superiority. Sunhee Koo examines the unique construction of diasporic Korean music in China and uses it as a window to understanding the complexities and diversification of Korean identity, shaped by the ideological and political bifurcation and post-Cold War political resurgence that have affected Northeast Asia. The performances of Korean Chinese musicians-positioned between their adopted state and the two Koreas-embody a complex cultural intersection crisscrossing ideological, political, and social boundaries in historical and present-day Northeast Asia. Migrants enact their agency in creating a unique sound for Korean Chinese identity through navigating cultural resources accessed in their host and the two distinctive motherlands"},
  isbn = {978-0-8248-8959-3 978-0-8248-8827-5},
  langid = {english},
  file = {/Users/matthieu/Zotero/storage/L22WHKVN/Koo - 2022 - Sound of the border music and identity of Korean minority nationality in China.pdf}
}

