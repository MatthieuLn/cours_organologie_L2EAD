  title = {Ancient {{DNA}} Indicates Human Population Shifts and Admixture in Northern and Southern {{China}}},
  author = {Yang, Melinda A. and Fan, Xuechun and Sun, Bo and Chen, Chungyu and Lang, Jianfeng and Ko, Ying-Chin and Tsang, Cheng-hwa and Chiu, Hunglin and Wang, Tianyi and Bao, Qingchuan and Wu, Xiaohong and Hajdinjak, Mateja and Ko, Albert Min-Shan and Ding, Manyu and Cao, Peng and Yang, Ruowei and Liu, Feng and Nickel, Birgit and Dai, Qingyan and Feng, Xiaotian and Zhang, Lizhao and Sun, Chengkai and Ning, Chao and Zeng, Wen and Zhao, Yongsheng and Zhang, Ming and Gao, Xing and Cui, Yinqiu and Reich, David and Stoneking, Mark and Fu, Qiaomei},
