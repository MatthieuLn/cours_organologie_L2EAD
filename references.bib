  abstract = {8\textasciitilde 9세기 신라에서 일본 황실로 전해진 고대 현악기 `신라금'은 최근까지 정창원에 소장되어 있었고, 이외 관련 유물로 양이두와 신라금갑 등이 현전하고 있으나, 지금까지 이에 대한 전모를 밝히는 연구가 시도되지 않았다. 필자는 이를 밝혀 신라금의 이해를 높이기 위한 목적으로 연구를 진행하였다. 정창원에 소장된 신라금과 관련 유물의 종류는 신라금 세 대 즉 1) 금니신라금 2) 금박신라금 3) 동대사명 신라금이 있고, 별도로 양이두 2점이 있는데, 하나는 완형이며, 다른 하나는 손상된 상태이다. 또한 신라금을 보관하는 악기 상자인 신라금갑도 두 개가 있는데, 본고에서 처음으로 금갑의 재료와 규격을 종합하였다. 이상의 유물 가운데 정창원에 유입된 내력이 분명한 것은 금니신라금과 금박신라금이다. 잡물출입장의 기록에 의하면, 823년 4월 14일에 납입된 것으로 보이며, 이때 현전하는 안족 4개와 안족 6개 그리고 신라금갑 2개도 부속으로 함께 납입된 것으로 추정된다. 일본 정창원에 소장된 신라금과 관련 유물을 검토한 결과, 이러한 실물은 8\textasciitilde 9세기 신라와 일본의 국제 교류에 악기를 비롯한 음악 교류도 활발히 이루어졌음을 시사한다. 신라 악기가 일본 황실에 유입되므로 인하여 신라의 음악 및 음악이론 그리고 악사(樂師)도 함께 전달되고 파견되었으니 이것이 일본 황실 및 관료들에게 미친 영향이 적지 않았음이 자명하다. 정창원 신라금 및 관련 유물은 8\textasciitilde 9세기 신라에서 제작하여 일본으로 전해진 유물들이다. 이것은 당시 신라인들의 신라금 제작 방법과 기술 수준을 가늠할 수 있게 하는 유물인 점에 그 의미와 가치가 있다.},
  langid = {korean},
  keywords = {En cours de lecture},
  file = {/Users/matthieu/Zotero/storage/YIFYCQT3/Kim - 2017 - 정창원 신라금과 관련 유물 연구.pdf;/Users/matthieu/Zotero/storage/CUHHGG8K/article.html}
}

@article{jinamUniqueCharacteristicsAinu2015,
  title = {Unique Characteristics of the {{Ainu}} Population in {{Northern Japan}}},
  author = {Jinam, Timothy A. and {Kanzawa-Kiriyama}, Hideaki and Inoue, Ituro and Tokunaga, Katsushi and Omoto, Keiichi and Saitou, Naruya},
  year = 2015,
  month = oct,
  journal = {Journal of Human Genetics},
  volume = {60},
  number = {10},
  pages = {565--571},
  publisher = {Nature Publishing Group},
  issn = {1435-232X},
  doi = {10.1038/jhg.2015.79},
  urldate = {2025-06-28},
  abstract = {Various genetic data (classic markers, mitochondrial DNAs, Y chromosomes and genome-wide single-nucleotide polymorphisms (SNPs)) have confirmed the coexistence of three major human populations on the Japanese Archipelago: Ainu in Hokkaido, Ryukyuans in the Southern Islands and Mainland Japanese. We compared genome-wide SNP data of the Ainu, Ryukyuans and Mainland Japanese, and found the following results: (1) the Ainu are genetically different from Mainland Japanese living in Tohoku, the northern part of Honshu Island; (2) using Ainu as descendants of the Jomon people and continental Asians (Han Chinese, Koreans) as descendants of Yayoi people, the proportion of Jomon genetic component in Mainland Japanese was \textasciitilde 18\% and \textasciitilde 28\% in Ryukyuans; (3) the time since admixture for Mainland Japanese ranged from 55 to 58 generations ago, and 43 to 44 generations ago for the Ryukyuans, depending on the number of Ainu individuals with varying rates of recent admixture with Mainland Japanese; (4) estimated haplotypes of some Ainu individuals suggested relatively long-term admixture with Mainland Japanese; and (5) highly differentiated genomic regions between Ainu and Mainland Japanese included EDAR and COL7A1 gene regions, which were shown to influence macroscopic phenotypes. These results clearly demonstrate the unique status of the Ainu and Ryukyuan people within East Asia.},
  copyright = {2015 The Japan Society of Human Genetics},
  langid = {english},
  keywords = {Genetic variation,Genome informatics},
  file = {/Users/matthieu/Zotero/storage/ZV6BCNT2/Jinam et al. - 2015 - Unique characteristics of the Ainu population in Northern Japan.pdf}
}

@article{jirajarupatTransmissionGuqinMusical2023,
  title = {The {{Transmission}} of {{Guqin Musical Instrument Knowledge Literacy}} and Its {{Reflection Study}} in {{Guizhou Province}}, {{China}}},
  author = {Jirajarupat, Phakamas and Yinghua, Zhang},
  year = 2023,
  month = apr,
  journal = {International Journal of Education and Literacy Studies},
  volume = {11},
  pages = {22--29},
  doi = {10.7575/aiac.ijels.v.11n.2p.22},
  abstract = {The Guqin is a string instrument that has been played in China for over 3,000 years. It is famous for its meditative, soothing sound and is frequently associated with Confucianism, Taoism, and Chinese literati culture. The instrument has seven strings that can be plucked with a plectrum or with the fingers. The Guqin's sound is said to resemble a gentle breeze blowing through the trees, and it is frequently used in Chinese music to evoke feelings of tranquillity and introspection. This study was conducted by statistically analyzing field research data and making recommendations for their educational status. In this study, samples of local Guqin musical instruments were selected, and a field study was carried out for the three local Guqin musical instrument groups, the Guangling sect, the Jiuyi sect, and the Yushan sect. The questionnaire was administered to 180 participants and included a literature analysis. The results of this study show that the province of Guizhou is home to a diverse collection of peoples, and the art of the Guqin is being modernized and incorporated to produce a form of art that the general populace appreciates. It is possible to make innovations and explore ways to form an ensemble using Guqin, Guzheng, Dizi, and other ethnic instruments, hold various Guqin concerts and art festivals, and engage in cultural and artistic exchanges. Guqin music will be celebrated at an increasing number of festivals in the future.},
  keywords = {didactique,notion},
  file = {/Users/matthieu/Zotero/storage/DRPC4GS6/Jirajarupat et Yinghua - 2023 - The Transmission of Guqin Musical Instrument Knowl.pdf}
}

