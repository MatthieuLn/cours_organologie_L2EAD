@article{diaz-andreuSoundscapesBajaCalifornia2021,
  title = {The Soundscapes of {{Baja California Sur}}: {{Preliminary}} Results from the {{Ca\~n\'on}} de {{Santa Teresa}} Rock Art Landscape},
