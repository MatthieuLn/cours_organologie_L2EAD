@misc{berryPostDigitalHumanitiesComputation2024,
  title = {Post-{{Digital Humanities}}: {{Computation}} and {{Cultural Critique}} in the {{Arts}} and {{Humanities}}},
  shorttitle = {Post-{{Digital Humanities}}},
  author = {Berry, David M.},
