@article{tangTWENTYFIRSTCENTURYSABAR2019,
  title = {{{TWENTY-FIRST CENTURY SABAR DRUMS}}: {{INNOVATIONS IN ORGANOLOGY AND PERFORMANCE PRACTICES IN SENEGAL AND THE DIASPORA}}},
  shorttitle = {{{TWENTY-FIRST CENTURY SABAR DRUMS}}},
  author = {Tang, Patricia},
