@incollection{hurFuneraryRitualsJapanese2014,
  title = {Funerary {{Rituals}} in {{Japanese Buddhism}}},
  booktitle = {The {{Wiley Blackwell Companion}} to {{East}} and {{Inner Asian Buddhism}}},
  author = {Hur, Nam-lin},
  year = 2014,
  pages = {239--258},
  publisher = {John Wiley \& Sons, Ltd},
  doi = {10.1002/9781118610398.ch12},
  urldate = {2026-05-07},
  abstract = {Japanese Buddhism is often dubbed ``funerary Buddhism.'' The danka system or danna, cemented the dominance of Buddhist forms of death-related rituals and ancestral rites in Japanese society. Under the anti-Christian system of temple certification, every household came to be affiliated with a danna temple of its choice. Over time, mortuary rites for the deceased were standardized into three dimensions---a mortuary ritual, a series of post-funereal memorial services, and annual ancestral rites---all under the aegis of funerary Buddhism. The conclusion of a funeral signaled the beginning of post-funereal care, memorial services designed to facilitate the transformation of the deceased into an ancestral deity. Ancestral deities, who were believed to join the cluster of deified spirits of the family, were given food offerings by their descendants on the occasions of annual observances. In Japanese society, filial piety focused upon the household institution rather than upon individual members of the household.},
  chapter = {12},
  copyright = {Copyright \copyright{} 2014 John Wiley \& Sons, Ltd},
  isbn = {978-1-118-61039-8},
  langid = {english},
  keywords = {A lire,ancestral deities,annual observances,anti-Christian,danka system,death-related rituals,filial piety,funerary Buddhism,Japanese Buddhism}
}

